# Agentic DevOps macOS setup: CORE (Apple Silicon)
# Only what an agent-assisted DevOps workflow needs. Nice-to-haves live in Brewfile.extras.
#   brew bundle --file config/Brewfile

tap "hashicorp/tap"
tap "azure/bicep"
tap "azure/kubelogin"
tap "microsoft/foundrylocal"

# ---------- Terminal & shell ----------
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
brew "tmux"                 # persistent sessions & splits
brew "starship"             # prompt
brew "zoxide"               # smarter cd
brew "fzf"                  # fuzzy finder (Ctrl-R / Ctrl-T)
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"

# ---------- Editor ----------
cask "visual-studio-code"

# ---------- Git & GitHub ----------
brew "git"                  # newer than Apple's
brew "git-delta"            # readable diffs
brew "gh"                   # GitHub CLI

# ---------- Containers & Kubernetes ----------
brew "podman"
brew "podman-compose"
brew "kubernetes-cli"       # kubectl
brew "helm"
brew "azure/kubelogin/kubelogin"   # Entra ID auth for AKS

# ---------- Azure & Infrastructure as Code ----------
cask "azure-cli"
brew "azd"                  # Azure Developer CLI
brew "azure/bicep/bicep"
brew "hashicorp/tap/terraform"
brew "opentofu"

# ---------- AI agents & local models ----------
cask "copilot-cli"          # GitHub Copilot CLI   (Claude Code: native installer, see scripts/ai.sh)
brew "opencode"             # open-source terminal agent, any model incl. local
brew "microsoft/foundrylocal/foundrylocal"   # on-device models on the Apple GPU

# ---------- Guardrails ----------
brew "gitleaks"             # secret scanning
brew "trivy"                # IaC / container / dependency scanning
brew "pre-commit"

# ---------- Runtimes & essentials ----------
brew "mise"                 # node/python/tflint versions
brew "uv"                   # Python packaging
brew "direnv"               # per-folder env vars
brew "jq"
brew "yq"
brew "ripgrep"
brew "fd"
brew "dockutil"             # used by the macOS step
