{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(terraform plan:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(tofu plan:*)",
      "Bash(tofu validate:*)",
      "Bash(tofu fmt:*)",
      "Bash(bicep build:*)",
      "Bash(az bicep build:*)",
      "Bash(tflint:*)",
      "Bash(trivy config:*)",
      "Bash(gitleaks:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(helm template:*)",
      "Bash(helm lint:*)"
    ],
    "ask": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(terraform state:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu state:*)",
      "Bash(az deployment:*)",
      "Bash(azd up:*)",
      "Bash(azd provision:*)",
      "Bash(azd deploy:*)",
      "Bash(azd down:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.pfx)",
      "Read(./**/terraform.tfstate)",
      "Read(./**/terraform.tfstate.backup)",
      "Read(./**/*.tfvars)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
